[sub_resource type="GDScript" id="GDScript_qfnet"]
script/source = "@tool
class_name IslandTerrain
extends MeshInstance3D

## Isla pequeña low-poly generada proceduralmente.
@export var radius: float = 14.0:
	set(v):
		radius = v
		_build()
@export var peak_height: float = 1.8:
	set(v):
		peak_height = v
		_build()
@export var noise_seed: int = 7:
	set(v):
		noise_seed = v
		_build()

const RES := 48
const SAND := Color(0.86, 0.78, 0.55)
const GRASS := Color(0.28, 0.5, 0.2)
const FOREST := Color(0.16, 0.36, 0.16)
const ROCK := Color(0.42, 0.4, 0.38)

func _ready() -> void:
	_build()

func _height(x: float, z: float, noise: FastNoiseLite) -> float:
	var r: float = Vector2(x, z).length() / radius
	var n: float = noise.get_noise_2d(x, z)
	r += n * 0.35
	var h: float = (1.0 - r) * 1.6
	if h > 0.0:
		h = h * peak_height * 0.7 + pow(h, 3.0) * peak_height * 0.5
	else:
		h = max(h * 3.0, -3.0)
	return h - 0.4

func _color(h: float) -> Color:
	if h < 0.35:
		return SAND
	if h < 1.4:
		return GRASS
	if h < 3.0:
		return FOREST
	return ROCK

func _build() -> void:
	if not is_inside_tree():
		return
	var noise := FastNoiseLite.new()
	noise.seed = noise_seed
	noise.frequency = 0.09
	var half: float = radius * 1.6
	var step: float = half * 2.0 / RES
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for i in RES:
		for j in RES:
			var x0: float = -half + i * step
			var z0: float = -half + j * step
			var p: Array[Vector3] = []
			for o: Vector2 in [Vector2(0, 0), Vector2(1, 0), Vector2(0, 1), Vector2(1, 1)]:
				var x: float = x0 + o.x * step
				var z: float = z0 + o.y * step
				p.append(Vector3(x, _height(x, z, noise), z))
			for tri: Array in [[0, 2, 1], [1, 2, 3]]:
				var c: float = (p[tri[0]].y + p[tri[1]].y + p[tri[2]].y) / 3.0
				st.set_color(_color(c))
				for k: int in tri:
					st.add_vertex(p[k])
	st.generate_normals()
	mesh = st.commit()
	var mat := StandardMaterial3D.new()
	mat.vertex_color_use_as_albedo = true
	mat.roughness = 1.0
	material_override = mat
	# Apoya los hijos (palmeras, etc.) sobre el terreno
	for c: Node in get_children():
		if c is Node3D:
			var n3: Node3D = c
			n3.position.y = _height(n3.position.x, n3.position.z, noise)
"

